{
  "schema_version": "1.0",
  "project": "TraceSurgery",
  "release": "1.0.3",
  "author": "Aura Yavary",
  "scope_note": "Only locally executed deterministic evidence is represented here. Frontier-model and external-environment performance claims remain pending.",
  "claims": [
    {
      "id": "TS-C001",
      "claim": "2/2 no-intervention control replays are replay-faithful in the deterministic local demo.",
      "scope": "software semantics only",
      "status": "verified_local",
      "evidence": [
        "runs/demo_5min.json"
      ],
      "rule": "count(kind=no_intervention)=2 and all replay_matches_source=true"
    },
    {
      "id": "TS-C002",
      "claim": "Exactly 3 intervention branches change the failed outcome to success in the deterministic local demo.",
      "scope": "software semantics only",
      "status": "verified_local",
      "evidence": [
        "runs/demo_5min.json"
      ],
      "rule": "count(kind!=no_intervention and success=true)=3"
    },
    {
      "id": "TS-C003",
      "claim": "At intervention step 0, action_patch and suffix_replan recover the task while state_patch does not.",
      "scope": "single deterministic failure case",
      "status": "verified_local",
      "evidence": [
        "runs/demo_5min.json",
        "artifacts/ablations/step0_action_patch.json",
        "artifacts/ablations/step0_state_patch.json",
        "artifacts/ablations/step0_suffix_replan.json"
      ],
      "rule": "step0 outcomes = action:true,state:false,suffix:true"
    },
    {
      "id": "TS-C004",
      "claim": "At intervention step 1, state_patch recovers the task while action_patch and suffix_replan do not.",
      "scope": "single deterministic failure case",
      "status": "verified_local",
      "evidence": [
        "runs/demo_5min.json",
        "artifacts/ablations/step1_action_patch.json",
        "artifacts/ablations/step1_state_patch.json",
        "artifacts/ablations/step1_suffix_replan.json"
      ],
      "rule": "step1 outcomes = action:false,state:true,suffix:false"
    },
    {
      "id": "TS-C005",
      "claim": "The Evidence Layer contains 9 documented investigations: 8 local causal investigations and 1 software-validation run.",
      "scope": "release process evidence",
      "status": "verified_local",
      "evidence": [
        "artifacts/experiment_logs/experiment_journal.jsonl"
      ],
      "rule": "journal rows=9; local_causal=8; software_validation=1"
    },
    {
      "id": "TS-C006",
      "claim": "The local intervention surface contains 3 failed repair attempts that changed the mechanistic interpretation.",
      "scope": "single deterministic failure case",
      "status": "verified_local",
      "evidence": [
        "runs/demo_5min.json",
        "docs/evidence/FAILED_EXPERIMENTS.md"
      ],
      "rule": "count(kind in action_patch,state_patch,suffix_replan and success=false)=3"
    },
    {
      "id": "TS-C007",
      "claim": "The Decision Log records 8 major design decisions.",
      "scope": "project process evidence",
      "status": "verified_local",
      "evidence": [
        "docs/evidence/DECISION_LOG.md"
      ],
      "rule": "count headings matching D-### = 8"
    },
    {
      "id": "TS-C008",
      "claim": "The Unexpected Findings log records 4 evidence-grounded findings.",
      "scope": "project process evidence",
      "status": "verified_local",
      "evidence": [
        "docs/evidence/UNEXPECTED_FINDINGS.md"
      ],
      "rule": "count headings matching U-### = 4"
    },
    {
      "id": "TS-C009",
      "claim": "No frontier-model comparison is populated in the released Evidence Layer.",
      "scope": "claim discipline",
      "status": "verified_local",
      "evidence": [
        "artifacts/eval_runs/EXTERNAL_RESULTS_PENDING.md",
        "docs/PUBLIC_CLAIMS.md"
